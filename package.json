{
  "name": "para-graph",
  "version": "0.15.2",
  "description": "Hybrid Code-Knowledge Graph tool for PARA Workspace",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "para-graph": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/graph/code-graph.d.ts",
      "import": "./dist/graph/code-graph.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "files": [
    "dist/",
    "src/queries/",
    "tool.manifest.yml",
    "install-hooks.sh"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.rmSync('dist/queries',{recursive:true,force:true});fs.cpSync('src/queries','dist/queries',{recursive:true});fs.mkdirSync('dist/hooks',{recursive:true});fs.cpSync('src/hooks/gemini.json','dist/hooks/gemini.json');fs.cpSync('src/graph/store/load-sqlite.cjs','dist/graph/store/load-sqlite.cjs');\"",
    "dev:test-install": "npm run build && tar -czf test.tar.gz dist/ package.json package-lock.json tool.manifest.yml install-hooks.sh && cd ../../../ && ./para install-tool para-graph --local=Projects/para-graph/repo/test.tar.gz --update --no-agents --no-mcp",
    "release:pack": "npm run build && tar -czf para-graph-v$npm_package_version.tar.gz dist/ package.json package-lock.json tool.manifest.yml install-hooks.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pageel/para-graph.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/pageel/para-graph/issues"
  },
  "homepage": "https://github.com/pageel/para-graph#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.6.0",
    "better-sqlite3": "^12.10.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-bash": "^0.21.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-php": "^0.23.12",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2"
  }
}
