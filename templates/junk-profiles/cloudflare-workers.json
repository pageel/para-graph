{
  "name": "cloudflare-workers",
  "detect": ["wrangler.toml"],
  "allowlist": [
    "node_modules/", "dist/", ".wrangler/",
    "package.json", "package-lock.json",
    "tsconfig.json", "wrangler.toml",
    ".gitignore", ".dev.vars",
    "README.md", "LICENSE", "CHANGELOG.md"
  ],
  "tiers": {
    "safe": ["*.log", ".mf/"],
    "prompt": ["*.sqlite", "*.tar.gz"],
    "report": []
  }
}
